o", "title": "Memo", "where": "Memo › Create New Memo", "color": "#5F292F", "num": "14", "secs": [{"label": "Edit Memo Details", "items": [{"f": "Date", "h": ""}, {"f": "* Worker/s", "h": ""}, {"f": "*Type", "h": "e.g. Child care arrangements, Transport arrangements"}, {"f": "Notes", "h": "The memo"}, {"f": "This note is also associated with (tick):", "h": ""}, {"f": "May be viewed by", "h": "Workgroup / Cluster"}, {"f": "Save", "h": ""}]}]}];
CL.forEach(c=>{let k=0;c.secs.forEach(sec=>sec.ids=sec.items.map(()=>c.id+'-'+(k++)));c.total=k});
const done=c=>c.secs.reduce((n,sec)=>n+sec.ids.filter(i=>ticks[i]).length,0);
const NOTES={};
function list(items){return '<ul class="items">'+items.map(t=>'<li>'+t+'</li>').join('')+'</ul>'}
function block(b){
  if(b.t==='p')return '<p class="p">'+b.text+'</p>';
  if(b.t==='note')return '<p class="note">'+b.text+'</p>';
  if(b.t==='list')return list(b.items);
  if(b.t==='sub')return '<div class="sub'+(b.key?' key':'')+'"><span class="tag">'+b.name+'</span>'+list(b.items)+(b.note?'<p class="note">'+b.note+'</p>':'')+'</div>';
  return '';
}
function navHtml(cur){
  if(mode==='check')return CL.map(c=>'<a href="#'+c.id+'"'+(c.id===cur?' aria-current="true"':'')+'><span class="chip" style="background:'+c.color+'">'+c.num+'</span><span class="t">'+c.title+'</span><span class="c">'+done(c)+'/'+c.total+'</span></a>').join('');
  return STEPS.map(s=>'<a href="#'+s.id+'"'+(s.id===cur?' aria-current="true"':'')+'><span class="chip" style="background:'+s.color+'">'+(s.num||'+')+'</span><span class="t">'+s.title+'</span></a>').join('');
}
function pager(arr,i,lab){
  const prev=arr[i-1],next=arr[i+1],st='display:inline-flex;align-items:center;text-decoration:none';
  return '<div class="pager">'+(prev?'<a class="btn" style="'+st+'" href="#'+prev.id+'">← '+lab(prev)+'</a>':'<span></span>')+(next?'<a class="btn primary" style="'+st+'" href="#'+next.id+'">'+lab(next)+' →</a>':'')+'</div>';
}
const FOOT='<p class="foot">Based on the SHIP User Guide (July 2011) and current KYS practice. Checklist ticks are saved only in this browser and hold no client details.</p>';
function renderGuide(id){
  const i=Math.max(0,STEPS.findIndex(s=>s.id===id));const s=STEPS[i];syncJump(s.id);
  $('#nav').innerHTML=navHtml(s.id);
  let body='',subs=[];
  s.blocks.forEach(b=>{if(b.t==='sub')subs.push(block(b));else{if(subs.length){body+='<div class="subs">'+subs.join('')+'</div>';subs=[]}body+=block(b)}});
  if(subs.length)body+='<div class="subs">'+subs.join('')+'</div>';
  $('#main').innerHTML='<section class="step" style="--c:'+s.color+'"><div class="sh"><span class="chip">'+(s.num||'+')+'</span><div><h2>'+s.title+'</h2><div class="where">'+s.where+'</div></div></div>'+body+'</section>'+pager(STEPS,i,label)+FOOT;
}
const NEWCLIENT=['check-search','check-new-client','check-details','check-support-period','check-notes'];
function secDone(sec){return sec.ids.filter(x=>ticks[x]).length}
function defaultOpen(c){const k=c.secs.findIndex(sec=>secDone(sec)<sec.ids.length);return new Set([k<0?0:k])}
function renderCheck(id){
  const i=Math.max(0,CL.findIndex(c=>c.id===id));const c=CL[i];syncJump(c.id);LS.set('last',c.id);
  if(!openSec[c.id])openSec[c.id]=defaultOpen(c);
  $('#nav').innerHTML=navHtml(c.id);
  const d=done(c),pct=c.total?Math.round(d/c.total*100):0,next=CL[i+1];
  const secs=c.secs.map((sec,k)=>{const sd=secDone(sec),full=sd===sec.ids.length;
    return '<details class="sec'+(full?' full':'')+'" data-k="'+k+'"'+(openSec[c.id].has(k)?' open':'')+'><summary><span class="nm">'+sec.label+'</span><span class="ct">'+(full?'✓ ':'')+sd+'/'+sec.ids.length+'</span></summary><ul class="items">'+sec.items.map((t,j)=>'<li'+(ticks[sec.ids[j]]?' class="isdone"':'')+'><label class="ck"><input type="checkbox" data-id="'+sec.ids[j]+'" data-k="'+k+'"'+(ticks[sec.ids[j]]?' checked':'')+'><span><b>'+t.f+'</b>'+(t.h?'<small class="hint">'+t.h+'</small>':'')+'</span></label></li>').join('')+'</ul></details>'}).join('');
  const all=c.total&&d===c.total;
  const doneBox=all?'<div class="alldone"><span>All done ✓ '+c.title+' is complete.</span>'+(next?'<a class="btn primary" style="display:inline-flex;align-items:center;text-decoration:none" href="#'+next.id+'">Next: '+next.title+' →</a>':'')+'</div>':'';
  $('#main').innerHTML='<div class="bar"><span class="total">'+d+' of '+c.total+' ticked</span><div class="tools2"><button class="btn" id="reset">Clear this checklist</button><button class="btn" id="newc">Start a new client</button></div><span class="confirm" id="cf"><span id="cfmsg"></span><button class="btn primary" id="yes">Yes, clear</button><button class="btn" id="no">Cancel</button></span></div>'+doneBox+'<section class="step check" style="--c:'+c.color+'"><div class="sh"><span class="chip">'+c.num+'</span><div><h2>'+c.title+'</h2><div class="where">'+c.where+'</div></div></div><div class="prog" aria-label="'+pct+'% done"><i style="width:'+pct+'%"></i></div>'+secs+'</section>'+pager(CL,i,x=>x.title)+HOWTO;
  let clearIds=null;
  const ask=(msg,ids)=>{clearIds=ids;$('#cfmsg').textContent=msg;$('#cf').classList.add('on');$('.tools2').style.display='none'};
  $('#reset').onclick=()=>ask('Clear all ticks in '+c.title+'?',[c.id]);
  $('#newc').onclick=()=>ask('Start a new client? This clears Search, Add new person, Details tab, SHS Support Period and Notes.',NEWCLIENT);
  $('#no').onclick=()=>renderCheck(c.id);
  $('#yes').onclick=()=>{CL.filter(x=>clearIds.includes(x.id)).forEach(x=>{x.secs.forEach(sec=>sec.ids.forEach(t=>delete ticks[t]));delete openSec[x.id]});save();renderCheck(c.id)};
  document.querySelectorAll('details.sec').forEach(el=>el.addEventListener('toggle',()=>{const k=+el.dataset.k;if(el.open)openSec[c.id].add(k);else openSec[c.id].delete(k)}));
}
const HOWTO='<details class="howto"><summary>Add SHIP Checklists to your phone’s home screen</summary><ol><li><b>iPhone:</b> open this page in Safari, tap the <b>Share</b> button, then <b>Add to Home Screen</b>.</li><li><b>Android:</b> open this page in Chrome, tap the <b>⋮</b> menu, then <b>Add to Home screen</b>.</li><li>Tap the KYS icon on your home screen to open the checklists any time, no scanning needed.</li></ol></details><p class="foot">Ticks are saved only on this phone or computer and hold no client details.</p>';
function esc(t){return t.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function renderSearch(q){
  const words=q.toLowerCase().split(/\s+/).filter(Boolean);const hits=[];
  STEPS.forEach(s=>s.blocks.forEach(b=>{(b.items?b.items:[b.text]).forEach(t=>{const pt=plain(t);const low=(pt+' '+(b.name||'')+' '+s.title).toLowerCase();if(words.every(w=>low.includes(w)))hits.push({s,where:b.name?plain(b.name):'',text:pt})})}));
  $('#nav').innerHTML=navHtml('');
  const re=new RegExp('('+words.map(w=>w.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')).join('|')+')','gi');
  $('#main').innerHTML='<h2 style="font-size:28px">'+hits.length+' result'+(hits.length===1?'':'s')+' for “'+esc(q)+'”</h2>'+(hits.length?'<div class="res">'+hits.slice(0,60).map(h=>'<button class="hit" style="--c:'+h.s.color+'" data-go="'+h.s.id+'"><small>'+esc(label(h.s))+(h.where?' › '+esc(h.where):'')+'</small>'+esc(h.text).replace(re,'<mark>$1</mark>')+'</button>').join('')+'</div>':'<div class="empty">Nothing matches. Try another word, such as “address”, “consent” or “closing”.</div>');
}
function current(){const h=(location.hash||'').slice(1);return CL.some(x=>x.id===h)?h:''}
function syncJump(id){const J=$('#jump');if(!J)return;J.value=[...J.options].some(o=>o.value===id)?id:'';document.body.classList.toggle('m-check',mode==='check')}
function route(){const h=current();if(!CL.some(x=>x.id===h)){const last=LS.get('last');if(last&&CL.some(x=>x.id===last)){location.replace('#'+last);return}}renderCheck(h)}
function setModeOnly(m){mode='check'}

const J=$('#jump');J.innerHTML='<option value="">Choose a checklist…</option>'+CL.map(c=>'<option value="'+c.id+'">'+c.num+'. '+c.title+'</option>').join('');
const BT=$('#bigtext');const setBig=on=>{document.documentElement.classList.toggle('big',on);BT.setAttribute('aria-pressed',on?'true':'false');BT.lastChild.textContent=on?' Normal text':' Bigger text';LS.set('big',on?'1':'0')};
setBig(LS.get('big')==='1');BT.onclick=()=>setBig(BT.getAttribute('aria-pressed')!=='true');
J.addEventListener('change',()=>{if(J.value)location.hash=J.value});
$('#main').addEventListener('change',e=>{const id=e.target.dataset&&e.target.dataset.id;if(!id)return;if(e.target.checked)ticks[id]=1;else delete ticks[id];save();
  const cid=current()||CL[0].id,c=CL.find(x=>x.id===cid)||CL[0],k=+e.target.dataset.k,sec=c.secs[k];
  if(openSec[c.id]&&secDone(sec)===sec.ids.length){openSec[c.id].delete(k);const n=c.secs.findIndex((s2,j)=>j>k&&secDone(s2)<s2.ids.length);if(n>=0)openSec[c.id].add(n)}
  const y=window.scrollY;renderCheck(c.id);window.scrollTo(0,y)});
window.addEventListener('hashchange',()=>{route();window.scrollTo(0,0)});
mode='check';document.body.classList.add('m-check');route();
}
</script></script>
