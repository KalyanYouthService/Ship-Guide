<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SHIP Checklists</title>
<meta name="theme-color" content="#74200A">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="SHIP Checklists">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap">
<style>
/* VOICE: calm, practical staff tool; Kalyan brand.
   IDEA: the SHIP client file, tab by tab, as a binder with coloured dividers.
   PICTURE: the working guide itself; each step a coloured divider.
   COLOUR and TYPE: Kalyan rust header, cream ground, six priority colours; Source Serif titles, Inter body.
   LAYOUT: header with search and mode switch; step list left; one step at a time right. */
:root{color-scheme:light dark;--bg:light-dark(#FAF5ED,#1d1512);--card:light-dark(#FFFDF9,#2a1f1a);--sub:light-dark(#F4ECDF,#33261f);--ink:light-dark(#2B1D17,#f3e9df);--muted:light-dark(#5A4A42,#c9b8ab);--line:light-dark(#E6D8C6,#4a3a30);--rust:#7D210A;--tan:#C49668}
:root[data-theme=light]{color-scheme:light}:root[data-theme=dark]{color-scheme:dark}
*{box-sizing:border-box;min-width:0}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 Inter,Arial,sans-serif;overflow-x:clip}
h1,h2,h3{font-family:'Source Serif 4',Georgia,serif;margin:0;text-wrap:balance}
button,input{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--tan);outline-offset:2px}
header{background:#74200A;color:#FFFDF9;border-bottom:4px solid var(--tan)}
.hin{max-width:1240px;margin:0 auto;padding:18px max(4vw,16px);display:flex;flex-wrap:wrap;align-items:center;gap:16px 24px}
.brand{display:flex;align-items:center;gap:18px;flex:1 1 360px}
.brand img{height:58px;width:auto}
.brand .sep{width:2px;align-self:stretch;background:var(--tan)}
.brand h1{font-size:clamp(26px,3vw,36px);line-height:1.05;font-weight:600}
.brand p{margin:2px 0 0;font-size:14px;color:#F5E6D6}
.tools{display:flex;flex-wrap:wrap;gap:10px;align-items:center;flex:1 1 420px;justify-content:flex-end}
.search{flex:1 1 240px;position:relative}
.search select{width:100%;height:46px;border-radius:10px;border:2px solid transparent;background:#FFFDF9;color:#2B1D17;padding:0 12px;font-size:16px;cursor:pointer}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.mode{display:flex;background:#5A1504;border-radius:10px;padding:4px}
.mode button{height:40px;padding:0 16px;border:0;border-radius:7px;background:transparent;color:#F5E6D6;font-weight:600;cursor:pointer}
.mode button[aria-pressed=true]{background:#FFFDF9;color:#7D210A}
.wrap{max-width:1240px;margin:0 auto;padding:24px max(4vw,16px) 48px;display:grid;grid-template-columns:280px minmax(0,1fr);gap:28px;align-items:start}
aside{position:sticky;top:16px;max-height:calc(100vh - 32px);overflow-y:auto}
nav{display:flex;flex-direction:column;gap:6px}
nav a{display:flex;align-items:center;gap:12px;min-height:48px;padding:6px 12px;border-radius:10px;text-decoration:none;color:var(--ink);border:1px solid transparent}
nav a:hover{background:var(--card)}
nav a[aria-current=true]{background:var(--card);border-color:var(--line);box-shadow:0 1px 3px rgba(90,21,4,.12)}
.chip{width:32px;height:32px;border-radius:16px;color:#fff;display:grid;place-items:center;font:700 15px 'Source Serif 4',Georgia,serif;flex:none}
nav .t{flex:1;font-weight:600;font-size:15px;line-height:1.25}
nav .c{font-size:13px;color:var(--muted);white-space:nowrap}
.rules{margin-top:14px;background:var(--rust);color:#FBEFE3;border-radius:12px;padding:16px 18px;font-size:14px;line-height:1.45}
.rules summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;min-height:32px}.rules summary::-webkit-details-marker{display:none}.rules summary::after{content:"–";font-size:22px;color:#F2D3A8}.rules:not([open]) summary::after{content:"+"}
.rules h2{font-size:19px;color:#fff}.rules[open] summary{margin-bottom:8px}
.rules p{margin:0 0 8px}.rules b{color:#F2D3A8}
main{display:flex;flex-direction:column;gap:18px}
.step{background:var(--card);border-radius:14px;border-top:8px solid var(--c);box-shadow:0 1px 4px rgba(90,21,4,.12);padding:clamp(18px,3vw,30px)}
.sh{display:flex;align-items:center;gap:16px;margin-bottom:16px}
.sh .chip{width:52px;height:52px;border-radius:26px;font-size:24px;background:var(--c)}
.sh h2{font-size:clamp(26px,3vw,36px);line-height:1.08}
.where{font-size:13px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--c);margin-top:4px}
:root[data-theme=dark] .where,:root:not([data-theme=light]) .where{color:light-dark(var(--c),#F2D3A8)}
.prog{height:8px;background:var(--sub);border-radius:4px;overflow:hidden;margin:-4px 0 16px}
.prog i{display:block;height:100%;background:var(--c);transition:width .3s}
.subs{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:14px}
.sub{background:var(--sub);border-radius:10px;padding:14px 16px}
.sub.key{outline:2px solid var(--c)}
.tag{display:inline-block;background:var(--c);color:#fff;font-weight:700;font-size:14px;border-radius:6px;padding:3px 10px;margin-bottom:8px}
ul.items{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:6px}
ul.items li{position:relative;padding-left:20px}
ul.items li::before{content:"";position:absolute;left:4px;top:.62em;width:7px;height:7px;border-radius:50%;background:var(--c)}
.check ul.items li{padding-left:0}.check ul.items li::before{display:none}
label.ck{display:flex;gap:12px;align-items:flex-start;cursor:pointer;padding:6px 8px;border-radius:8px;min-height:44px}
label.ck:hover{background:var(--line)}
label.ck input{width:22px;height:22px;margin:2px 0 0;accent-color:var(--c);flex:none}
label.ck input:checked+span{color:var(--muted);text-decoration:line-through;text-decoration-color:var(--tan)}
.hint .rule{display:block;margin-top:2px}
.hint{display:block;font-size:14px;font-weight:400;color:var(--muted);margin-top:1px}
label.ck input:checked+span .hint{text-decoration:none}
details.sec{background:var(--sub);border-radius:10px;margin:0 0 10px}
details.sec>summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:10px;min-height:52px;padding:8px 14px;font-weight:700}
details.sec>summary::-webkit-details-marker{display:none}
details.sec>summary .nm{flex:1;color:var(--c)}
details.sec>summary .ct{font-size:14px;color:var(--muted);font-weight:600;white-space:nowrap}
details.sec>summary::after{content:"+";font-size:22px;color:var(--c);width:18px;text-align:center}
details.sec[open]>summary::after{content:"–"}
details.sec.full>summary .ct{color:#3f6b2a}
details.sec .items{padding:0 6px 10px}
.hideticked li.isdone{display:none}
.tools2{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.switch{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);font-weight:600;cursor:pointer}
.switch input{width:20px;height:20px;accent-color:var(--rust)}
.alldone{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;background:#EAF2E2;color:#24401a;border:1px solid #b9d3a5;border-radius:12px;padding:14px 16px;margin:0 0 14px;font-weight:600}
:root[data-theme=dark] .alldone{background:#22331c;color:#d9ecc9;border-color:#3d5a31}
.howto{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:4px 16px}
.howto summary{cursor:pointer;min-height:48px;display:flex;align-items:center;font-weight:600}
.howto ol{margin:0 0 12px;padding-left:20px}
.textbtn{height:46px;padding:0 14px;border-radius:10px;border:2px solid #F2D3A8;background:transparent;color:#FFFDF9;font-weight:700;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:2px}
.textbtn .bigA{font-size:1.35em;margin-right:6px}
.textbtn[aria-pressed=true]{background:#FFFDF9;color:#7D210A;border-color:#FFFDF9}
html.big label.ck{font-size:20px}
html.big label.ck b{font-size:20px}
html.big .hint{font-size:17px}
html.big details.sec>summary{font-size:19px;min-height:58px}
html.big details.sec>summary .ct{font-size:16px}
html.big .sh h2{font-size:32px}
html.big .where{font-size:15px}
html.big .bar,html.big .btn,html.big .alldone,html.big .howto{font-size:18px}
html.big .search select{font-size:19px}
html.big label.ck input{width:28px;height:28px}
@media(max-width:860px){.textbtn{flex:1 1 100%;order:3;justify-content:center;height:46px}}
.p{margin:0 0 14px}.note{margin:12px 0 0;color:var(--muted);font-style:italic;font-size:15px}
.pager{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.btn{min-height:46px;padding:0 18px;border-radius:10px;border:1px solid var(--line);background:var(--card);font-weight:600;cursor:pointer}
.btn.primary{background:var(--rust);color:#fff;border-color:var(--rust)}
.bar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;background:var(--card);border-radius:12px;padding:14px 18px;border:1px solid var(--line)}
.bar .total{font-weight:600}
.confirm{display:none;gap:8px;align-items:center;flex-wrap:wrap}.confirm.on{display:flex}
mark{background:#F2D3A8;color:#2B1D17;border-radius:3px;padding:0 2px}
.res{display:flex;flex-direction:column;gap:10px}
.hit{display:block;text-align:left;width:100%;background:var(--card);border:1px solid var(--line);border-left:6px solid var(--c);border-radius:10px;padding:12px 16px;cursor:pointer}
.hit small{display:block;font-weight:700;color:var(--muted);font-size:13px;margin-bottom:2px}
.empty{background:var(--card);border-radius:12px;padding:24px;color:var(--muted)}
.foot{font-size:13px;color:var(--muted)}
@media(max-width:860px){.wrap{grid-template-columns:minmax(0,1fr)}aside{position:static;max-height:none;overflow:visible}nav{flex-direction:row;overflow-x:auto;gap:8px;padding-bottom:6px}nav a{flex:none}nav .t{white-space:nowrap}}
@media(max-width:860px){
 header{position:sticky;top:0;z-index:5}
 .hin{padding:10px 14px;gap:10px}
 .brand{flex:1 1 auto;gap:10px}.brand img{height:38px}.brand .sep{display:none}.brand h1{font-size:22px}.brand p{display:none}
 .tools{flex:1 1 100%;gap:8px}.search{flex:1 1 100%;order:2}
 .search select{height:50px;font-size:17px;font-weight:600}
 .wrap{padding:14px 12px 40px;gap:14px}
 aside{display:none}
 .step{padding:16px 14px;border-radius:12px}
 .sh{gap:12px;margin-bottom:12px}.sh .chip{width:42px;height:42px;font-size:20px}.sh h2{font-size:24px}
 .subs{grid-template-columns:minmax(0,1fr);gap:10px}
 .sub{padding:12px 10px}
 label.ck{padding:10px 8px;gap:14px;font-size:17px;min-height:52px}
 label.ck input{width:26px;height:26px}
 .hint{font-size:15px}
 .bar{padding:12px}
 .bar .btn{min-height:44px}
 .pager{flex-direction:column}.pager .btn{justify-content:center;width:100%}
}
@media(prefers-reduced-motion:reduce){.prog i{transition:none}}
</style>
</head>
<body>
<header><div class="hin">
<div class="brand"><img src="data:image/png;base64," alt="Kalyan Youth Service"><div class="sep"></div><div><h1>SHIP Checklists</h1><p>Tick off each field as you enter it in SHIP</p></div></div>
<div class="tools">
<div class="search"><label for="jump" class="sr">Go to</label><select id="jump" aria-label="Choose a checklist"></select></div><button id="bigtext" class="textbtn" aria-pressed="false" title="Make the text bigger"><span aria-hidden="true">A</span><span aria-hidden="true" class="bigA">A</span> Bigger text</button>

</div></div></header>
<div class="wrap">
<aside><nav id="nav" aria-label="Steps"></nav>
</aside>
<main id="main"></main>
</div>
